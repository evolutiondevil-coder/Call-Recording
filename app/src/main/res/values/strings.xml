    <string name="setup_title">Разрешения и настройка</string>
    <string name="setup_subtitle">Няколко бързи стъпки и всеки разговор ще се записва — по телефона, във Viber, WhatsApp, Messenger и други.</string>
    <string name="step_required">Стъпка %d · задължително</string>
